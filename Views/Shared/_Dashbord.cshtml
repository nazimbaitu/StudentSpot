<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudentSpot - Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/index.css" />

</head>
<body>
    <header>
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div class="left-section" style="display: flex; align-items: center;">
                <span class="toggle-btn" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </span>
                <div class="brand">
                    <div class="brand-logo">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <span class="brand-text">StudentSpot</span>
                </div>
            </div>
            <div class="admin-section">
                @* <div class="admin-btn">
                    <i class="fas fa-user"></i>
                    <span>Admin Login</span>
                </div> *@
                <div class="admin-btn">
                    <a href="@Url.Action("Logout", "Admin")" class="admin-logout-btn" style="text-decoration: none; color: white;">
                        <div class="admin-btn">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sidebar Hover Area -->
        <div class="sidebar-hover-area" id="sidebarHoverArea"></div>

        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <ul class="sidebar-menu">
                <li><a href="@Url.Action("Index", "Admin")" class="active"><i class="fas fa-home"></i> Home</a></li>
                <li><a href="@Url.Action("Profile", "Admin")"><i class="fas fa-user-circle"></i> Profile</a></li>
                <li><a href="@Url.Action("fetchProduct", "Admin")"><i class="fas fa-box"></i> Products</a></li>
                <li><a href="@Url.Action("fetchCategory", "Admin")"><i class="fas fa-layer-group"></i> Category</a></li>
                <li><a href="@Url.Action("fetchCustomer", "Admin")"><i class="fas fa-users"></i> Customers</a></li>
                <li><a href="@Url.Action("fetchCart", "Admin")"><i class="fas fa-shopping-cart"></i> Cart</a></li>
                <li><a href="@Url.Action("feedback", "Admin")"><i class="fas fa-address-book"></i> Feedback</a></li>
                <li><a href="@Url.Action("fechBlog", "Admin")"><i class="fas fa-chart-bar"></i> Blog</a></li>
                <li><a href="@Url.Action("FetchBayOrders", "Admin")"><i class="fas fa-shopping-cart"></i> Orders</a></li>
                <li><a href="@Url.Action("Logout", "Admin")"><i class="fas fa-cog"></i> Settings</a></li>
            </ul>
        </div>

        <!-- Overlay -->
        
    </header>
    <div class="overlay" id="overlay"></div>
    <main>
        <div>
        @RenderBody()
    </div>
    </main>

    <!-- Footer -->
    
<script src="~/js/index.js"></script>
</body>
</html>
