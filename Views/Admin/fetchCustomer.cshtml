
@* <h2 class="page-title">Customer List</h2> *@

<div class="table-container" >
    <h2 class="page-title">Customer List</h2>
    <table class="table table-striped table-hover custom-table">
        <thead>
            <tr>
                <th>Customer Id</th>
                <th>Customer Name</th>
                <th>Customer Email</th>
                <th>Customer Password</th>
                <th>Customer Phone</th>
                <th>Customer Address</th>
                <th>Customer Gender</th>
                @* <th>Customer Image</th> *@
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.customer_id</td>
                    <td>@customer.customer_name</td>
                    <td>@customer.customer_email</td>
                    <td>@customer.customer_password</td>
                    <td>@customer.customer_phone</td>
                    <td>@customer.customer_adress</td>
                    <td>@customer.customer_gender</td>
                    @* <td>@customer.customer_image</td> *@
                    <td>

                        <a href="@Url.Action("customerDetails", "Admin", new { id = customer.customer_id })" class="btn-link details">Details</a>
                        <a href="@Url.Action("customerUpdate", "Admin", new { id = customer.customer_id })" class="btn-link update">Update</a>
                        <a href="@Url.Action("customerDelete", "Admin", new { id = customer.customer_id })" class="btn-link delete">Delete</a>
                    </td>

                </tr>

            }
        </tbody>
    </table>
</div>

<link rel="stylesheet" href="~/css/fetchCustomer.css" />
