@model IEnumerable<StudentSpot.Models.BayNow>

@{
    ViewData["Title"] = "All Orders";
}

<h2>All Orders</h2>

<style>
    h2 {
        text-align: center;
        margin-bottom: 30px;
        font-weight: 600;
        color: #2c3e50;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        margin: auto;
        font-size: 15px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

        .custom-table th, .custom-table td {
            text-align: center;
            vertical-align: middle;
            padding: 12px;
            border: 1px solid #dee2e6;
        }

        .custom-table thead {
            background-color: #343a40;
            color: white;
        }

        .custom-table tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .custom-table tbody tr:hover {
            background-color: #f1f1f1;
        }

    .badge {
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .bg-warning {
        background-color: #ffc107;
        color: #000;
    }

    .bg-success {
        background-color: #28a745;
        color: #fff;
    }

    .bg-secondary {
        background-color: #6c757d;
        color: #fff;
    }

    .btn {
        display: inline-block;
        font-weight: 500;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        border: none;
        padding: 6px 12px;
        font-size: 0.85rem;
        border-radius: 4px;
        text-decoration: none;
        color: #fff;
        cursor: pointer;
    }

    .btn-sm {
        padding: 4px 10px;
        font-size: 0.8rem;
    }

    .btn-success {
        background-color: #28a745;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-primary {
        background-color: #007bff;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }

    .ms-2 {
        margin-left: 8px;
    }

    form.inline-form {
        display: inline-block;
        margin-left: 8px;
    }

    media (max-width: 768px) {
        .custom-table

    {
        font-size: 13px;
    }

    .btn-sm {
        font-size: 0.75rem;
        padding: 3px 8px;
    }

    }
</style>

<table class="table table-bordered table-striped custom-table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Cart ID</th>
            <th>Customer Name</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Status / Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            var cart = order.Cart;
            var product = cart?.Products;
            var customer = cart?.customers;

            <tr>
                <td>@order.order_i</td>
                <td>@cart?.cart_id</td>
                <td>@customer?.customer_name</td>
                <td>@product?.product_name</td>
                <td>@cart?.product_quantity</td>
                <td>@String.Format("{0:C}", product?.product_price)</td>
                <td>
                    @if (order.Bay_status_id == 0)
                    {
                        <span class="badge bg-warning">Pending</span>
                        <form asp-action="ApproveOrder" asp-controller="Admin" method="post" class="inline-form" onsubmit="return confirm('Are you sure to approve this order?');">
                            <input type="hidden" name="id" value="@order.order_i" />
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                    }
                    else if (order.Bay_status_id == 1)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Unknown</span>
                    }

                    <a href="@Url.Action("OrderDetails", "Admin", new { id = order.order_i })" class="btn btn-sm btn-primary ms-2">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
