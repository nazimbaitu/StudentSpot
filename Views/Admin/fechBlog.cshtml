
@{
    ViewData["Title"] = "fechBlog";
    Layout = "~/Views/Shared/_Dashbord.cshtml";
}

@model IEnumerable<StudentSpot.Models.Bestblog>

@{
    ViewData["Title"] = "All Blogs";
}
<link rel="stylesheet" href="~/css/fechBlog-foradmin.css" />

<div class="containeralikhan">
    <h2>All Blogs</h2>
    <a href="@Url.Action("AddBlog", "Admin")" class="btn btn-success">Add New Blog</a>

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Image</th>
                <th>Options</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var blog in Model)
            {
                <tr>
                    <td>@blog.blog_name</td>
                    <td>@blog.blog_description</td>
                    <td>
                        @if (!string.IsNullOrEmpty(blog.blog_image))
                        {
                            <img src="~/blog_image/@blog.blog_image" width="100" />
                        }
                        else
                        {
                            <span>No Image</span>
                        }
                    </td>
                    <td>
                        <div class="button-column">
                            <a href="@Url.Action("BlogDetails", "Admin", new { id = blog.blog_id })" class="btn btn-primary">Details</a>
                            <a href="@Url.Action("UpdateBlog", "Admin", new { id = blog.blog_id })" class="btn btn-warning">Update</a>
                            <a href="@Url.Action("DeleteBlog", "Admin", new { id = blog.blog_id })" class="btn btn-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
