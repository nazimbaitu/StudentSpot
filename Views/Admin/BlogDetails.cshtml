
@{
    ViewData["Title"] = "BlogDetails";
    Layout = "~/Views/Shared/_Dashbord.cshtml";
}
@model StudentSpot.Models.Bestblog


<style>
    .details-box {
        max-width: 600px;
        margin: 40px auto;
        padding: 25px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.1);
        text-align: center;
    }

        .details-box img {
            display: block;
            margin: 0 auto 20px auto;
            max-width: 200px;
            height: auto;
            border-radius: 10px;
            box-shadow: 0px 3px 10px rgba(0,0,0,0.1);
        }

    .details-list {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        font-size: 16px;
        color: #333;
    }

        .details-list li {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

            .details-list li strong {
                color: #007bff;
                margin-right: 5px;
            }

    .btn-link {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        background: #007bff;
        color: white;
        font-size: 14px;
        transition: 0.3s;
    }

        .btn-link:hover {
            background: #0056b3;
        }

</style>

<div class="details-box">
    <h2>Blog Details</h2>

    <!-- Blog Image -->
    @if (!string.IsNullOrEmpty(Model.blog_image))
    {
        <img src="@Url.Content("~/blog_image/" + Model.blog_image)" alt="Blog Image" />
    }
    else
    {
        <img src="https://via.placeholder.com/200x150" alt="No Image" />
    }

    <!-- Blog Info -->
    <ul class="details-list">
        <li><strong>ID:</strong> @Model.blog_id</li>
        <li><strong>Title:</strong> @Model.blog_name</li>
        <li><strong>Description:</strong> @Model.blog_description</li>
    </ul>

    <a href="@Url.Action("fechBlog", "Admin")" class="btn-link">Back to Blog List</a>
</div>
