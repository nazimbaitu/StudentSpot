
@{
    ViewData["Title"] = "UpdateBlog";
    Layout = "~/Views/Shared/_Dashbord.cshtml";
}
@model StudentSpot.Models.Bestblog

<h2 style="text-align:center; text-transform:uppercase; letter-spacing:4px;">
    Update / Edit Blog
</h2>

<form method="post" enctype="multipart/form-data" class="custom-form">
    <input type="hidden" name="blog_id" value="@Model.blog_id" />

    <label>Blog Title</label>
    <input type="text" name="blog_name" placeholder="Enter Blog Title" value="@Model.blog_name" required />

    <label>Blog Description</label>
    <input type="text" name="blog_description" placeholder="Enter Blog Description" value="@Model.blog_description" required />

    <label>Current Blog Image</label><br />
    @if (!string.IsNullOrEmpty(Model.blog_image))
    {
        <img src="~/blog_image/@Model.blog_image" height="80px" width="80px" style="margin-bottom:10px;" />
    
        <br />
    }
    else
    {
        <p>No image uploaded.</p>
    }

    <label>Upload New Image</label>
    <input type="file" name="blogImage" />

    <input type="hidden" name="existingImage" value="@Model.blog_image" />

    <input type="submit" value="Update Blog" />
</form>

<style>
    .custom-form {
        max-width: 500px;
        margin: 30px auto;
        padding: 25px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.1);
        font-family: Arial, sans-serif;
    }

        .custom-form label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            color: #333;
            font-size: 14px;
        }

        .custom-form input[type="text"],
        .custom-form input[type="file"] {
            width: 100%;
            padding: 10px 12px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border 0.3s, box-shadow 0.3s;
        }

            .custom-form input[type="text"]:focus,
            .custom-form input[type="file"]:focus {
                border-color: #007bff;
                box-shadow: 0px 0px 6px rgba(0,123,255,0.5);
            }

        .custom-form input[type="submit"] {
            width: 100%;
            background: #007bff;
            color: white;
            font-size: 15px;
            font-weight: bold;
            padding: 12px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }

            .custom-form input[type="submit"]:hover {
                background: #0056b3;
            }
</style>

