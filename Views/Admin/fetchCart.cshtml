@model IEnumerable<StudentSpot.Models.Cart>


<style>
    h2 {
        text-align: center;
        margin: 20px 0;
        font-size: 28px;
        color: #333;
    }

    .table {
        width: 90%;
        margin: 0 auto 40px auto;
        border-collapse: collapse;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        font-family: 'Segoe UI', sans-serif;
        font-size: 16px;
    }

        .table thead {
            background-color: #4CAF50;
            color: white;
        }

        .table th, .table td {
            padding: 12px 16px;
            border: 1px solid #ddd;
            text-align: center;
        }

        .table tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .table tbody tr:hover {
            background-color: #f1f1f1;
            transition: background-color 0.3s;
        }

    /* ✅ Buttons */
    .btn-edit,
    .btn-delete {
        padding: 6px 12px;
        border-radius: 4px;
        text-decoration: none;
        color: white;
        margin: 14px;
        display: flex;
    }

    .btn-edit {
        background-color: #2196F3;
    }

    .btn-delete {
        background-color: #f44336;
    }

    .btn-edit:hover {
        background-color: #0b7dda;
    }

    .btn-delete:hover {
        background-color: #d32f2f;
    }
</style>
<h2>Cart Items</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            @* <th>Cart ID</th> *@
            <th>Product ID</th>
            <th>Customer ID</th>
            <th>Products-Quntites</th>
            <th>Products Price </th>
            <th>Status</th>
            @* <th>Price</th> *@
            <th>Actions</th> <!-- ✅ new column -->

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @* <td>@item.cart_id</td> *@
                <td>@item.Products.product_name  </td>
                <td>@item.customers.customer_name</td>
                <td>@item.product_quantity</td>
                <td> @item.Products.product_price</td>
                <td>@item.status_id</td>

                @* <td>@item.price</td> *@
                <td>
                    <!-- Edit Button -->
                    <a href="@Url.Action("EditCart", "Admin", new { id = item.cart_id })" class="btn-edit">Edit</a>

                    <!-- Delete Button -->
                    <a href="@Url.Action("DeleteCart", "Admin", new { id = item.cart_id })" class="btn-delete" onclick="return confirm('Are you sure you want to delete this cart item?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
