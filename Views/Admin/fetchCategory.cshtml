@model IEnumerable<StudentSpot.Models.Category>

@{
    ViewData["Title"] = "Category List";
}

<h2 class="page-title">Category List</h2>

<!-- Dropdown Call -->
@await Html.PartialAsync("_CategoryDropdown", Model)

<div class="table-container">

    <div class="add-btn-container">
        <a href="@Url.Action("addCategory", "Admin")" class="btn-primary">
            + Add New Category
        </a>
    </div>

    <table class="table table-striped table-hover custom-table">
        <thead>
            <tr>
                <th>Category Id</th>
                <th>Category Name</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td>@cat.category_id</td>
                    <td>@cat.category_name</td>
                    <td>
                        <a href="@Url.Action("updateCategory", "Admin", new { id = cat.category_id })"
                           class="btn-link details">
                            Update
                        </a>

                        <a href="@Url.Action("deletePermissionCategory", "Admin", new { id = cat.category_id })"
                           class="btn-link delete">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    /* General Page Styling */
    .page-title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
        text-align: center;
    }

    /* Table Container */
    .table-container {
        max-width: 900px;
        margin: 30px auto;
        padding: 15px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
    }

    /* Table */
    .custom-table {
        width: 100%;
        border-collapse: collapse;
        text-align: center;
        font-size: 16px;
    }

        .custom-table thead {
            background: #007bff;
            color: #fff;
        }

        .custom-table th,
        .custom-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #ddd;
        }

        .custom-table tr:hover {
            background-color: #f1f1f1;
            transition: 0.3s;
        }

    /* Add Button */
    .add-btn-container {
        text-align: right;
        margin-bottom: 10px;
    }

        .add-btn-container .btn-primary {
            background-color: #007bff;
            color: #fff;
            padding: 8px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            transition: 0.3s;
        }

            .add-btn-container .btn-primary:hover {
                background-color: #0056b3;
            }

    /* Action Buttons */
    .btn-link {
        text-decoration: none;
        padding: 6px 12px;
        margin: 2px;
        border-radius: 6px;
        font-size: 14px;
        display: inline-block;
        transition: 0.3s;
    }

        .btn-link.details {
            background: #28a745;
            color: white;
        }

            .btn-link.details:hover {
                background: #1e7e34;
            }

        .btn-link.delete {
            background: #dc3545;
            color: white;
        }

            .btn-link.delete:hover {
                background: #a71d2a;
            }

</style>
