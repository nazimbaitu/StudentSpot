@model StudentSpot.Models.Product

<h2>Product Details</h2>
<style>
    /* Details Box */
    .details-box {
        max-width: 500px;
        margin: 30px auto;
        padding: 20px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.1);
        text-align: center;
    }

        /* Product Image */
        .details-box img {
            display: block;
            margin: 0 auto 15px auto;
            max-width: 150px;
            height: auto;
            border-radius: 8px;
            box-shadow: 0px 3px 10px rgba(0,0,0,0.1);
        }

    /* Details List */
    .details-list {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
        font-size: 16px;
        color: #333;
    }

        .details-list li {
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

            .details-list li strong {
                color: #007bff;
                margin-right: 5px;
            }

    /* Back Button */
    .btn-link {
        display: inline-block;
        margin-top: 15px;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        background: #007bff;
        color: white;
        font-size: 14px;
        transition: 0.3s;
    }

        .btn-link:hover {
            background: #0056b3;
        }

</style>


<div class="details-box">

    <h2>Product Details</h2>
    <!-- Image Top -->
    <img src="@("~/products_image/" + Model.product_image)" asp-append-version="true"
         height="50px" width="50px">

    <!-- Details in List -->
    <ul class="details-list">
        <li><strong>ID:</strong> @Model.product_id</li>
        <li><strong>Name:</strong> @Model.product_name</li>
        <li><strong>Price:</strong> @Model.product_price</li>
        <li><strong>desccription:</strong> @Model.product_description</li>
        <li><strong>Category:</strong> @Model.Category.category_name</li>


    </ul>
    <a href="@Url.Action("fetchProduct", "Admin")" class="btn-link">Back to List</a>
</div>


