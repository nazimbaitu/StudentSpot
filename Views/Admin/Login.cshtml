@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Ecommerce Website</title>
    <link rel="stylesheet" href="~/css/login.css">
</head>
<body>
    <div class="login-container">
        <h2>Login</h2>
        <form id="loginForm" method="post">
            <div class="input-group">
                <label for="email">Email</label>
                <input type="email" name="adminEmail" id="email" placeholder="Enter your email" required>
            </div>

            <div class="input-group">
                <label for="password">Password</label>
                <input type="password" name="adminPassword" id="password" placeholder="Enter your password" required>
            </div>

            <button type="submit" value="login" class="btn">Login</button>

            <p class="signup-link">@ViewBag.Error</p>


            @* <p class="signup-link">Don’t have an account? <a href="#">Register</a></p>  *@
        </form>
    </div>

    <script src="js/login.js"></script>
</body>
</html>
