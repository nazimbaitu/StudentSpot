@{
    ViewData["Title"] = "About";
    Layout = "~/Views/_customer.cshtml";
}

<link rel="stylesheet" href="~/css/ali.css" />

<div class="zh-about-wrapper">

    <!-- HERO SECTION -->
    <section class="zh-hero">
        <div class="hero-title-box">
            <h1 class="zh-title">ZelloHub</h1>
            <p class="zh-desc">
                ZelloHub is a modern e-commerce platform built to provide
                affordable essentials, verified products, and a seamless
                shopping experience for students and everyday customers.
            </p>
        </div>
    </section>

    <!-- MISSION SECTION -->
    <section class="mission-section zh-section">
        <h2 class="section-title">Our Mission</h2>
        <div class="mission-container">
            <div class="mission-text">
                <p>Founded in 2023, ZelloHub was created to simplify online shopping with affordability and reliability at its core.</p>
                <p>We aim to provide quality products at competitive prices while ensuring a smooth and secure buying experience.</p>
                <p>Our goal is to build long-term trust with customers through transparency, fast service, and verified suppliers.</p>
            </div>
            <div class="mission-image">
                <img src="https://images.unsplash.com/photo-1523580494863-6f3031224c94?auto=format&fit=crop&w=800&q=80" alt="E-commerce shopping">
            </div>
        </div>
    </section>

    <!-- VALUES SECTION -->
    <section class="values-section zh-section">
        <h2 class="section-title">Our Values</h2>
        <div class="values-container">
            <div class="value-card">
                <h3>Customer First</h3>
                <p>Every decision we make is focused on improving your shopping experience.</p>
            </div>
            <div class="value-card">
                <h3>Best Value Pricing</h3>
                <p>We work directly with suppliers to keep our prices affordable.</p>
            </div>
            <div class="value-card">
                <h3>Verified Products</h3>
                <p>All products go through quality checks before being listed.</p>
            </div>
            <div class="value-card">
                <h3>Fast & Reliable Shipping</h3>
                <p>Quick order processing and dependable delivery services.</p>
            </div>
        </div>
    </section>

    <!-- WHY CHOOSE ZELLOHUB -->
    <section class="why-section zh-section">
        <h2 class="section-title">Why Choose ZelloHub?</h2>
        <div class="values-container">
            <div class="value-card">
                <h3>Secure Payments</h3>
                <p>Advanced encryption ensures safe and secure transactions.</p>
            </div>
            <div class="value-card">
                <h3>Easy Returns</h3>
                <p>Hassle-free return policies for complete peace of mind.</p>
            </div>
            <div class="value-card">
                <h3>24/7 Customer Support</h3>
                <p>Our support team is always ready to assist you anytime.</p>
            </div>
        </div>
    </section>

</div>
