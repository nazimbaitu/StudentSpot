@model IEnumerable<StudentSpot.Models.Bestblog>

@{
    ViewData["Title"] = "Blog Detail";
    Layout = "~/Views/_customer.cshtml";
}
<link rel="stylesheet" href="~/css/blogDitail.css" />
<main class="container mt-4">
    @* <h2 class="mb-4">Blog Detail</h2> *@

    @if (Model != null && Model.Any())
    {
        var blog = Model.First();

        <div class="blog-detail">
            <h3>@blog.blog_name</h3>

            @if (!string.IsNullOrEmpty(blog.blog_image))
            {
                <div class="blog-image mb-3">
                    <img src="@Url.Content("~/blog_image/" + blog.blog_image)" alt="@blog.blog_name" class="img-fluid" />
                </div>
            }

            <div class="scrollable-content">
                <p>@Html.Raw(blog.blog_description)</p>
            </div>
        </div>
    }
    else
    {
        <p>No blog found.</p>
    }
</main> 