@model List<BayNow>

@{
    ViewData["Title"] = "MyOrders";
    Layout = "~/Views/_customer.cshtml"; // path check کریں
}
<link rel="stylesheet" href="~/css/MYorders.css" />
<div class="my-orders-container">
    <h2 class="page-title">My Orders</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table orders-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="product-name">@order.Cart?.Products?.product_name</td>
                        <td><span class="quantity-badge">@order.Cart?.product_quantity</span></td>
                        <td class="product-price">$@order.Cart?.Products?.product_price</td>
                        <td>
                            @if (order.Bay_status_id == 0)
                            {
                                <span class="status-badge status-pending">Pending</span>
                            }
                            else if (order.Bay_status_id == 1)
                            {
                                <span class="status-badge status-approved">Approved</span>
                            }
                            else
                            {
                                <span class="status-badge status-unknown">Unknown</span>
                            }
                        </td>
                        <td class="order-date">@order.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-orders">
            <div class="empty-orders-icon">📦</div>
            <div class="empty-orders-text">No orders found</div>
            <a href="/Shop" class="shop-now-btn">Shop Now</a>
        </div>
    }
</div>
