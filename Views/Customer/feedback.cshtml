
@{
    ViewData["Title"] = "feedback";
    Layout = "~/Views/_customer.cshtml";
}
 <link rel="stylesheet" href="~/css/feedback.css" />
@* <h1>feedback</h1> *@

<!-- Contact Section -->
<section id="contact">
    <!-- Form -->
    <div class="contact-form">
        <h2>Get In Touch With Us</h2>
        <form method="post">
            <input type="text" name="name" placeholder="Enter Your Full Name" required>
            <textarea name="message" placeholder="Enter Your Message" required></textarea>
            <input type="submit" value="Submit">
        </form>
    </div>

    <!-- Map -->
    <div class="contact-map">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3419.994066570105!2d74.35178874999998!3d30.998542649999997!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3919c9b163654a0f%3A0x5227ca9e8eefc5d4!2sTara%20Garh!5e0!3m2!1sen!2s!4v1758789092742!5m2!1sen!2s" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
</section>
