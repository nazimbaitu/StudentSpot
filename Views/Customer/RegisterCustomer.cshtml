@{
    Layout = null;
}
@model StudentSpot.Models.Customer

<h2>Customer Register</h2>

<form id="customer-registration-form" class="registration-form" asp-action="customerRegister" method="post" enctype="multipart/form-data">
    <label>Name</label>
    <input type="text" asp-for="customer_name" required />

    <label>Email</label>
    <input type="email" asp-for="customer_email" required />

    <label>Password</label>
    <input type="password" asp-for="customer_password" required />

    <label>Phone</label>
    <input type="text" asp-for="customer_phone" />

    <label>Address</label>
    <input type="text" asp-for="customer_adress" />

    <label>Gender</label>
    <select asp-for="customer_gender">
        <option value="Male">Male</option>
        <option value="Female">Female</option>
    </select>

    <label>Upload Image</label>
    <input type="file" name="customerImage" accept="image/*" />

    <button type="submit">Register</button>
</form>
